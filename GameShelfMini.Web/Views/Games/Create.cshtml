@using GameShelfMini.Data.Enums
@{
    ViewData["Title"] = "Нова игра";
}

<h1>Добавяне на игра</h1>

@if (ViewData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label for="title" class="form-label">Заглавие</label>
        <input id="title" name="title" class="form-control" maxlength="200" required />
    </div>

    <div class="mb-3">
        <label for="developer" class="form-label">Разработчик</label>
        <input id="developer" name="developer" class="form-control" maxlength="100" required />
    </div>

    <div class="mb-3">
        <label for="platform" class="form-label">Платформа</label>
        <select id="platform" name="platform" class="form-select"
                asp-items="Html.GetEnumSelectList<Platform>()"></select>
    </div>

    <div class="mb-3">
        <label for="genre" class="form-label">Жанр</label>
        <select id="genre" name="genre" class="form-select"
                asp-items="Html.GetEnumSelectList<Genre>()"></select>
    </div>

    <div class="mb-3">
        <label for="releaseYear" class="form-label">Година на излизане</label>
        <input id="releaseYear" name="releaseYear" type="number"
               class="form-control" min="1970" max="2100" value="2026" required />
    </div>

    <button type="submit" class="btn btn-primary">Запази</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>